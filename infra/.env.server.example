APP_NAME=EduFX MVC API
FRONTEND_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
GOOGLE_CLOUD_PROJECT=responsive-sun-491204-e0
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=384
DATA_BACKEND=memory
DEMO_MODE=true
# Auth: run  gcloud auth application-default login  before starting the server

# --- Free AI fallback chain (used when Vertex AI billing is unavailable) ---
# Free key, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: fine-tuned model hosted on an AWS EC2 GPU box (vLLM, OpenAI-compatible).
# Setup steps: docs/finetune-aws-hosting-guide.md
# FINETUNED_MODEL_URL=
# FINETUNED_MODEL_NAME=edufx

# Admin access to /admin is a `role` column on the students table (see
# migration add_role_to_students), not an env var — promote/demote students
# via the admin portal itself, or `update students set role = 'admin' ...`
# for the very first admin.

# --- Study reminders (server/app/services/reminder_service.py) ---
# Optional. Unset locally -> send_email logs instead of sending real email.
# Free tier: https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=EduFX <reminders@edufx.app>
# Shared secret the reminders.yml scheduled GitHub Action sends as
# X-Internal-Secret when it calls POST /internal/reminders/run. Unset locally
# -> that endpoint allows any caller (fine for dev, never leave unset in prod).
REMINDERS_SHARED_SECRET=
